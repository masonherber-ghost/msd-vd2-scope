# Root .env — read by Vite. Everything here is compiled into the public client
# bundle, so it must never contain a secret. Firebase web config values are
# public identifiers (Project settings → Your apps → Config); firestore.rules
# is the security boundary.
VITE_API_URL=http://localhost:3001

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true points the app at the local emulators (npm run emulators). Restart Vite
# after changing it.
VITE_USE_EMULATORS=false
