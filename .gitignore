# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Environment — never commit real values, only the .example files
.env
.env.*
!.env.example

# SQLite: all three WAL-mode files, not just the database
*.db
*.db-journal
*.db-wal
*.db-shm
# Backups are deliberately committable — see the /backup-db skill.
!server/backups/*.db

# Uploaded files live on disk; only filenames go in the database
server/uploads/

# Editor / OS
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
logs/
*.log
npm-debug.log*

# Firebase: emulator state, debug logs, and the Admin SDK key (a real secret)
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
admin/service-account.json
