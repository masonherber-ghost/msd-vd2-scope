{
  "name": "msd-vd2-scope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:client\" \"npm:server\"",
    "client": "vite",
    "server": "tsx watch server/server.ts",
    "build": "tsc -b && vite build",
