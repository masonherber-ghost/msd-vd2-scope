    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "reconcile": "tsx scripts/reconcile-report.ts",
    "backup-db": "tsx scripts/backup-db.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
